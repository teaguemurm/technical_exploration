# mlx-lm LoRA config for the v2 app-layout constraint adapter.
# Run from lora/:  mlx_lm.lora --config configs/qwen25_1.5b_constraint_v2.yaml
#
# Same settings as qwen25_1.5b_constraint.yaml. The only change is data,
# which points at the app condition-B set in data/v2.
#
# Paths are relative to the working directory, not to this file.
# Use the bf16 Hugging Face repo. If --model points at a quantized MLX
# model, mlx-lm trains QLoRA instead of bf16 LoRA.

model: "Qwen/Qwen2.5-1.5B-Instruct"
train: true
fine_tune_type: lora
optimizer: adamw

data: "data/v2"
seed: 42

# Qwen2.5-1.5B-Instruct has 28 layers. -1 selects every block
# (mlx-lm uses layers[-max(num_layers, 0):], and -0 is 0).
num_layers: -1

batch_size: 4
iters: 500
val_batches: -1
learning_rate: 1.0e-4
steps_per_report: 10
steps_per_eval: 50
save_every: 50
adapter_path: "adapters"
max_seq_length: 2048
grad_checkpoint: false
mask_prompt: true

# Rank 16 is inside the planned 8–16 range. scale is mlx-lm's multiplier,
# not PEFT's lora_alpha. The converter sets lora_alpha = scale * rank.
# Embeddings and lm_head are omitted: Qwen2.5 ties them, and llama.cpp
# rejects an adapter that contains either.
lora_parameters:
  keys:
    - "self_attn.q_proj"
    - "self_attn.k_proj"
    - "self_attn.v_proj"
    - "self_attn.o_proj"
    - "mlp.gate_proj"
    - "mlp.up_proj"
    - "mlp.down_proj"
  rank: 16
  scale: 20.0
  dropout: 0.0
